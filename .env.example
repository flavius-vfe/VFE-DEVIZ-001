SERVER_IP=192.168.0.50
FRONTEND_PORT=3080
BACKEND_PORT=8030
DEVIZ_VERSION=0.1.6

POSTGRES_DB=deviz
POSTGRES_USER=deviz
POSTGRES_PASSWORD=SCHIMBA_PAROLA_DB
POSTGRES_DATA=/mnt/user/appdata/vfe-deviz/postgres
BACKEND_DATA=/mnt/user/appdata/vfe-deviz/backend
DEVIZ_DATA=/mnt/user/deviz-data

DATABASE_URL=postgresql+psycopg://deviz:SCHIMBA_PAROLA_DB@postgres:5432/deviz
# Opțional. Lăsat gol, frontend-ul folosește protocolul și hostname-ul ferestrei plus portul 8030.
API_BASE_URL=

SESSION_DAYS=7
DEFAULT_LOCALE=ro-RO
DEFAULT_CURRENCY=RON
DEFAULT_VAT_RATE=21
DEFAULT_LOCALITY=Ceahlău
DEFAULT_COUNTY=Neamț
