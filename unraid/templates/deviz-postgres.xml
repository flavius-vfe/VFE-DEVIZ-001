<?xml version="1.0"?>
<Container version="2">
  <Name>vfe-deviz-postgres</Name>
  <Repository>postgres:18.6</Repository>
  <Network>vfe-deviz</Network>
  <Config Name="Database" Target="POSTGRES_DB" Default="deviz" Mode="" Type="Variable" Display="always"/>
  <Config Name="User" Target="POSTGRES_USER" Default="deviz" Mode="" Type="Variable" Display="always"/>
  <Config Name="Password" Target="POSTGRES_PASSWORD" Default="" Mode="" Type="Variable" Display="always" Mask="true"/>
  <Config Name="PostgreSQL data" Target="/var/lib/postgresql/data" Default="/mnt/user/appdata/deviz/postgresql" Mode="rw" Type="Path" Display="always"/>
</Container>
