<?xml version="1.0"?>
<Container version="2">
  <Name>vfe-deviz-worker</Name>
  <Repository>ghcr.io/flavius-vfe/vfe-deviz-worker:0.1.4</Repository>
  <Registry>https://github.com/flavius-vfe/VFE-DEVIZ-001/pkgs/container/vfe-deviz-worker</Registry>
  <Network>vfe-deviz</Network>
  <Overview>Worker VFE Deviz fără porturi publicate; accesează PostgreSQL numai pe rețeaua internă.</Overview>
  <Category>Tools:</Category>
  <Config Name="Database URL" Target="DATABASE_URL" Default="postgresql+psycopg://deviz:CHANGE_ME@vfe-deviz-postgres:5432/deviz" Mode="" Description="Înlocuiește CHANGE_ME cu aceeași parolă ca la PostgreSQL" Type="Variable" Display="always" Required="true" Mask="true"/>
  <Config Name="Refresh interval" Target="REFRESH_INTERVAL_SECONDS" Default="86400" Mode="" Description="Interval între actualizări, în secunde" Type="Variable" Display="always" Required="true"/>
  <Config Name="Database retry" Target="DATABASE_RETRY_SECONDS" Default="5" Mode="" Description="Interval de reconectare la PostgreSQL" Type="Variable" Display="advanced" Required="true"/>
</Container>
